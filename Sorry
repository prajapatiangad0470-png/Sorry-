<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>I am Sorry</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', 'Segoe UI', sans-serif;
        }
        body {
            background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
        }

        /* 3D Flip Card Container */
        .card-container {
            perspective: 1000px;
            width: 340px;
            height: 380px;
            z-index: 10;
        }

        .card {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .card.flipped {
            transform: rotateY(180deg);
        }

        .front, .back {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.95);
            box-shadow: 0 15px 35px rgba(255, 105, 135, 0.2);
            padding: 30px 25px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            border: 2px solid #fff;
        }

        .back {
            transform: rotateY(180deg);
        }

        .emoji {
            font-size: 55px;
            margin-bottom: 15px;
        }

        h2 {
            color: #d63384;
            font-size: 22px;
            margin-bottom: 20px;
        }

        input {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #f8d7da;
            border-radius: 10px;
            outline: none;
            font-size: 15px;
            margin-bottom: 15px;
            text-align: center;
        }

        input:focus {
            border-color: #d63384;
        }

        button {
            width: 100%;
            padding: 12px;
            background: #d63384;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(214, 51, 132, 0.3);
        }

        .result-title {
            font-size: 24px;
            font-weight: bold;
            margin-top: 10px;
        }

        .btn-reset {
            margin-top: 20px;
            background: #6c757d;
            padding: 8px 15px;
            font-size: 14px;
            width: auto;
        }

        /* Heart Shower Styling */
        .heart-particle {
            position: fixed;
            bottom: -50px;
            user-select: none;
            pointer-events: none;
            z-index: 1;
            animation: floatUp 4s linear forwards;
        }

        @keyframes floatUp {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
        }
    </style>
</head>
<body>

    <div class="card-container">
        <div class="card" id="card">
            
            <!-- Front Side -->
            <div class="front">
                <div class="emoji">🥺</div>
                <h2>I am Sorry,<br>mujhe maaf krdo!</h2>
                <input type="text" id="userInput" placeholder="Jawab yahan likho..." autocomplete="off">
                <button onclick="checkAnswer()">Submit ❤️️</button>
            </div>

            <!-- Back Side -->
            <div class="back">
                <div class="emoji" id="backEmoji">🥰</div>
                <div class="result-title" id="backText">Thank You! ❤️</div>
                <button class="btn-reset" onclick="resetCard()">Wapas jayein</button>
            </div>

        </div>
    </div>

    <script>
        function checkAnswer() {
            const inputVal = document.getElementById('userInput').value.trim().toLowerCase();
            const card = document.getElementById('card');
            const backEmoji = document.getElementById('backEmoji');
            const backText = document.getElementById('backText');

            if (!inputVal) return;

            const positiveAnswers = ['thik he', 'thik hai', 'ok', 'yes', 'haa', 'ha', 'maaf kiya', 'fine'];

            if (positiveAnswers.includes(inputVal)) {
                backEmoji.textContent = "🥰";
                backText.textContent = "Thank You! ❤️✨";
                backText.style.color = "#198754";
                createHeartsShower();
            } else {
                backEmoji.textContent = "😭";
                backText.textContent = "Plz forgive me! 🥺🙏";
                backText.style.color = "#dc3545";
            }

            card.classList.add('flipped');
        }

        function resetCard() {
            document.getElementById('card').classList.remove('flipped');
            document.getElementById('userInput').value = '';
        }

        function createHeartsShower() {
            const hearts = ['❤️', '💖', '💕', '💗', '✨', '🌸'];
            for (let i = 0; i < 40; i++) {
                setTimeout(() => {
                    const heart = document.createElement('div');
                    heart.classList.add('heart-particle');
                    heart.textContent = hearts[Math.floor(Math.random() * hearts.length)];
                    heart.style.left = Math.random() * 100 + 'vw';
                    heart.style.animationDuration = (Math.random() * 2 + 3) + 's';
                    heart.style.fontSize = (Math.random() * 20 + 20) + 'px';
                    document.body.appendChild(heart);

                    setTimeout(() => heart.remove(), 5000);
                }, i * 100);
            }
        }
    </script>

</body>
</html>
